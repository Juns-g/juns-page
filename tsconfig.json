{
  "include": ["app/**/*", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "jsx": "react-jsx",
    "types": ["@react-router/node", "vite/client"],
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
